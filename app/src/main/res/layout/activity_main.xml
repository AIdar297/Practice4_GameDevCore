<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:visibility="visible">

    <LinearLayout
        android:id="@+id/locationButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp">

        <Button
            android:id="@+id/btnMorning"
            android:onClick="btnMorningClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/morning" />

        <Button
            android:id="@+id/btnDay"
            android:onClick="btnDayClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/day" />

        <Button
            android:id="@+id/btnEvening"
            android:onClick="btnEveningClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/evening" />

        <Button
            android:id="@+id/btnNight"
            android:onClick="btnNightClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/night" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/locationButtons"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/night"
            android:scaleType="fitCenter"
            android:contentDescription="Ночная локация"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imgEvening"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/evening"
            android:scaleType="fitCenter"
            android:contentDescription="Вечерняя локация"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imgDay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/day"
            android:scaleType="fitCenter"
            android:contentDescription="Дневная локация"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/imgMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/morning"
            android:scaleType="fitCenter"
            android:contentDescription="Утренняя локация"
            android:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false">

            <Button
                android:id="@+id/btnLaptop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.01"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:onClick="onLaptopClick"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.15"
                app:layout_constraintHorizontal_bias="0.565"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.62"
                app:layout_constraintWidth_percent="0.30" />

            <Button
                android:id="@+id/btnNotebook"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.01"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:onClick="onNotebookClick"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.15"
                app:layout_constraintHorizontal_bias="0.229"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.796"
                app:layout_constraintWidth_percent="0.50" />

            <Button
                android:id="@+id/btnMug"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.01"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:onClick="onMugClick"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.12"
                app:layout_constraintHorizontal_bias="0.785"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.658"
                app:layout_constraintWidth_percent="0.15" />

            <Button
                android:id="@+id/btnHeroFigure"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.01"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:onClick="onHeroFigureClick"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.15"
                app:layout_constraintHorizontal_bias="0.922"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.724"
                app:layout_constraintWidth_percent="0.15" />

            <Button
                android:id="@+id/btnCat"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.01"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:onClick="onCatClick"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.15"
                app:layout_constraintHorizontal_bias="0.951"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.6"
                app:layout_constraintWidth_percent="0.20" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>